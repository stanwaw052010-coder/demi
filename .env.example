# ─────────────────────────────────────────────────────────────────────────────
# Well's of Yunnan
#
# Every variable here is optional. With none of them set the site runs in full:
# payments are simulated, mail is written to the console, and the order is
# stored on disk. That is deliberate — `npm install && npm run dev` has to give
# a working shop, including the confirmation page, with no accounts anywhere.
# ─────────────────────────────────────────────────────────────────────────────

# Absolute origin, used for canonical URLs, hreflang, the sitemap, JSON-LD and
# the Open Graph image. No trailing slash. Defaults to https://wellsofyunnan.be.
# Set this on every deploy, or the canonicals will point somewhere else.
NEXT_PUBLIC_SITE_URL=https://wellsofyunnan.be

# Note on hosting: on a serverless platform the order store falls back to the
# temp directory, because the project root is read-only there. Orders then only
# survive inside one warm instance. See the Vercel section in README.md before
# taking real payments.

# ── Payments ────────────────────────────────────────────────────────────────
# Mollie first: it carries Bancontact, iDEAL and Payconiq natively, which is
# what a Belgian shop actually needs. Set this and the checkout redirects to
# Mollie's hosted page instead of simulating.
# Test keys start with test_, live keys with live_.
# MOLLIE_API_KEY=<uw-mollie-testsleutel>

# Stripe is the fallback, used only when MOLLIE_API_KEY is absent.
# STRIPE_SECRET_KEY=<uw-stripe-testsleutel>

# ── Mail ────────────────────────────────────────────────────────────────────
# Without this the confirmation email is logged rather than sent, and the
# checkout still completes.
# RESEND_API_KEY=<uw-resend-sleutel>

# The From header on order confirmations. Must be a domain verified at Resend.
# MAIL_FROM=Well's of Yunnan <hallo@wellsofyunnan.be>

# Newsletter audience. Without it the signup form records the intent and
# reports success without calling anything.
# RESEND_AUDIENCE_ID=<uw-audience-id>
