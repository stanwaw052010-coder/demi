# ============================================================
#  Настройки бота. Скопируйте этот файл в .env и заполните.
#      cp .env.example .env
#  Файл .env в git не попадает — он в .gitignore.
# ============================================================

# Токен бота. Где взять: Telegram -> @BotFather -> /newbot -> скопировать токен.
# Выглядит примерно так: 1234567890:AAH4x-abcdefghijklmnopqrstuvwxyz012
BOT_TOKEN=

# Telegram ID мастера (Анны). Только этот пользователь видит панель мастера.
# Где взять: Telegram -> @userinfobot -> /start -> строка "Id".
# Это число, без кавычек и без @.
ADMIN_ID=
