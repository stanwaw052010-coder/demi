# ============================================================
#  Настройки бота. Скопируйте этот файл в .env и заполните.
#      cp .env.example .env        (Windows: copy .env.example .env)
#  Файл .env в git не попадает — он в .gitignore.
#  На сервере права должны быть 600:  chmod 600 .env
# ============================================================

# --- Обязательные ---

# Токен бота. Где взять: Telegram -> @BotFather -> /newbot -> скопировать токен.
BOT_TOKEN=

# Telegram ID владелицы. Только эти люди видят панель и получают заявки.
# Где взять: Telegram -> @userinfobot -> /start -> строка "Id".
# Можно указать несколько через запятую: 123456789,987654321
ADMIN_IDS=


# ============================================================
#  Ниже — только для сервера. Локально ничего менять не нужно:
#  без этих переменных база, логи и копии лягут рядом с кодом.
#  На сервере их выставляет systemd (см. deploy/profitime-bot.service).
# ============================================================

# Файл базы. На сервере лежит ВНЕ каталога кода, чтобы обновление
# кода физически не могло его задеть.
# DB_PATH=/var/lib/profitime-bot/bot.db

# Каталог логов. Туда же пишется отметка heartbeat.
# LOG_DIR=/var/log/profitime-bot

# Каталог резервных копий. Оттуда бот раз в неделю берёт свежую копию
# и отправляет её админу в Telegram.
# BACKUP_DIR=/var/backups/profitime-bot

# Писать логи в файл с ротацией (10 МБ × 5 архивов).
# Локально не нужно — хватает вывода в консоль.
# LOG_TO_FILE=1
